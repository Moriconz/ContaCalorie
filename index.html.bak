<!DOCTYPE html>
<html lang="it" data-theme="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <meta name="description" content="Monitora calorie, proteine e macro ogni giorno con una PWA mobile-first." />
  <meta name="theme-color" content="#6366f1" media="(prefers-color-scheme: light)" />
  <meta name="theme-color" content="#0f0f1e" media="(prefers-color-scheme: dark)" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
  <meta name="apple-mobile-web-app-title" content="Conta Calorie" />
  <title>Conta Calorie</title>
  <link rel="manifest" href="/manifest.webmanifest" />
  
  <!-- Theme & Glassmorphism CSS -->
  <link rel="stylesheet" href="css/theme.css" />
  <link rel="stylesheet" href="css/glassmorphism.css" />
  <link rel="stylesheet" href="css/background.css" />
  <link rel="stylesheet" href="css/styles.css" />
  
  <link rel="icon" href="icons/icon-192.svg" />
  <link rel="apple-touch-icon" href="icons/apple-touch-icon.png" />
  
  <script>
    // Carica tema dal localStorage PRIMA di rendere la pagina
    const savedTheme = localStorage.getItem('theme') || 'dark';
    document.documentElement.setAttribute('data-theme', savedTheme);
  </script>
  <script>
    // REGISTRA IL SERVICE WORKER SUBITO - IL PIÙ PRESTO POSSIBILE
    if ('serviceWorker' in navigator) {
      navigator.serviceWorker.register('/sw.js').catch(e => {
        console.error('SW registration failed:', e);
      });
    }

    // Cattura beforeinstallprompt IL PIÙ PRESTO POSSIBILE
    window.__beforeInstallPromptEvent = null;
    window.__beforeInstallPromptCaught = false;

    window.addEventListener('beforeinstallprompt', (e) => {
      console.log('🎉 beforeinstallprompt CATTURATO!');
      e.preventDefault();
      window.__beforeInstallPromptEvent = e;
      window.__beforeInstallPromptCaught = true;
    }, true);

    console.log('✅ SW + beforeinstallprompt listener registrati nel <head>');
  </script>
</head>
<body>
  <!-- Animated background container with blobs -->
  <div class="bg-container">
    <div class="blob blob-1"></div>
    <div class="blob blob-2"></div>
    <div class="blob blob-3"></div>
    <div class="blob blob-4"></div>
  </div>

  <!-- Content wrapper -->
  <div class="content-wrapper">
    <div id="app" class="app-shell">
      <header class="topbar navbar">
        <div class="brand">Conta Calorie</div>
        <div class="topbar-actions">
          <button id="installAppBtn" class="install-topbar-btn" aria-label="Aggiungi alla schermata home" title="Aggiungi alla schermata home">
            📲
          </button>
          <button id="themeToggle" class="icon-button" aria-label="Cambia tema">☀️</button>
        </div>
      </header>

      <main id="mainContent" class="page-content"></main>

      <nav id="bottomNav" class="bottom-nav" aria-label="Navigazione principale"></nav>
    </div>
  </div>

  <!-- App scripts -->
  <script type="module">
    import { themeManager } from './js/themeManager.js';
    import { initApp } from './js/app.js';

    // Inizializza tema manager
    console.log('🎨 ThemeManager inizializzato');

    // Setup theme toggle button
    const themeToggle = document.getElementById('themeToggle');
    if (themeToggle) {
      themeToggle.addEventListener('click', () => {
        const newTheme = themeManager.toggleTheme();
        updateThemeIcon(newTheme);
      });
      updateThemeIcon(themeManager.getTheme());
    }

    function updateThemeIcon(theme) {
      if (themeToggle) {
        themeToggle.textContent = theme === 'dark' ? '🌙' : '☀️';
      }
    }

    // Listen for theme changes
    window.addEventListener('themechange', (e) => {
      updateThemeIcon(e.detail.theme);
    });

    // Inizializza app
    await initApp();
  </script>
</body>
</html>
